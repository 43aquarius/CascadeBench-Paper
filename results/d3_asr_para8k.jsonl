{"key": "rn0/rz050", "ok": true, "text": "元大党。", "latency_s": 0.37, "lang": "zh", "usage": null}
{"key": "rn0/rz042", "ok": true, "text": "", "latency_s": 0.17, "lang": "zh", "usage": null}
{"key": "rn0/rz051", "ok": true, "text": "北京。", "latency_s": 0.23, "lang": "zh", "usage": null}
{"key": "rn0/rz052", "ok": true, "text": "", "latency_s": 0.18, "lang": "zh", "usage": null}
{"key": "rn0/rz043", "ok": true, "text": "景区商家要。", "latency_s": 0.36, "lang": "zh", "usage": null}
{"key": "rn0/rz048", "ok": true, "text": "", "latency_s": 0.17, "lang": "zh", "usage": null}
{"key": "rn0/rz049", "ok": true, "text": "", "latency_s": 0.26, "lang": "zh", "usage": null}
{"key": "rn0/rz053", "ok": true, "text": "要去。商贸零售点。我继续整治。", "latency_s": 0.52, "lang": "zh", "usage": null}
{"key": "rn0/rz054", "ok": true, "text": "", "latency_s": 0.15, "lang": "zh", "usage": null}
{"key": "rn0/rz058", "ok": true, "text": "这样的成绩已经比。", "latency_s": 0.33, "lang": "zh", "usage": null}
{"key": "rn0/rz059", "ok": true, "text": "", "latency_s": 0.24, "lang": "zh", "usage": null}
{"key": "rn0/rz055", "ok": true, "text": "而10公里。刘九公。14分10秒左右。", "latency_s": 0.48, "lang": "zh", "usage": null}
{"key": "rn0/rz064", "ok": true, "text": "对现。", "latency_s": 0.26, "lang": "zh", "usage": null}
{"key": "rn0/rz056", "ok": true, "text": "最生。", "latency_s": 0.34, "lang": "zh", "usage": null}
{"key": "rn0/rz065", "ok": true, "text": "", "latency_s": 0.18, "lang": "zh", "usage": null}
{"key": "rn0/rz057", "ok": true, "text": "", "latency_s": 0.19, "lang": "zh", "usage": null}
{"key": "rn0/rz060", "ok": true, "text": "一八农业。", "latency_s": 0.26, "lang": "zh", "usage": null}
{"key": "rn0/rz066", "ok": true, "text": "全国商品房。代收面积。增加了。", "latency_s": 0.48, "lang": "zh", "usage": null}
{"key": "rn0/rz061", "ok": true, "text": "严厉打击。价外收费等为。", "latency_s": 0.48, "lang": "zh", "usage": null}
{"key": "rn0/rz067", "ok": true, "text": "用户。大型广告收入。", "latency_s": 0.41, "lang": "zh", "usage": null}
{"key": "rn0/rz070", "ok": true, "text": "在工作。", "latency_s": 0.22, "lang": "zh", "usage": null}
{"key": "rn0/rz062", "ok": true, "text": "二套房贷首付比。", "latency_s": 0.41, "lang": "zh", "usage": null}
{"key": "rn0/rz071", "ok": true, "text": "园区总。", "latency_s": 0.24, "lang": "zh", "usage": null}
{"key": "rn0/rz063", "ok": true, "text": "", "latency_s": 0.2, "lang": "zh", "usage": null}
{"key": "rn0/rz072", "ok": true, "text": "", "latency_s": 0.26, "lang": "zh", "usage": null}
{"key": "rn0/rz068", "ok": true, "text": "是小班的。一年。", "latency_s": 0.33, "lang": "zh", "usage": null}
{"key": "rn0/rz073", "ok": true, "text": "为加快发展银行间。", "latency_s": 0.3, "lang": "zh", "usage": null}
{"key": "rn0/rz069", "ok": true, "text": "申。张明明。", "latency_s": 0.39, "lang": "zh", "usage": null}
{"key": "rn0/rz074", "ok": true, "text": "", "latency_s": 0.17, "lang": "zh", "usage": null}
{"key": "rn0/rz075", "ok": true, "text": "对，七年级。", "latency_s": 0.28, "lang": "zh", "usage": null}
