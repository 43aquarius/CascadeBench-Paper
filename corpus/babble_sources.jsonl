{"id": "babble_en_03", "lang": "en", "text": "I need to charge my laptop.", "voice": "sambert-hanna-v1"}
{"id": "babble_en_04", "lang": "en", "text": "Let's meet at the usual place.", "voice": "sambert-clara-v1"}
{"id": "babble_en_05", "lang": "en", "text": "This tea tastes wonderful.", "voice": "sambert-cally-v1"}
{"id": "babble_en_06", "lang": "en", "text": "The printer needs more paper.", "voice": "sambert-waan-v1"}
{"id": "babble_en_07", "lang": "en", "text": "She left her keys on the desk.", "voice": "sambert-cindy-v1"}
